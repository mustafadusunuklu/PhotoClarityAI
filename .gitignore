# Signing material and local credentials (no release key is required for baseline)
*.jks
*.keystore
*.p12
*.pfx
*.pem
.env
.env.*
keystore.properties
signing.properties
credentials.properties

# gradle/wrapper/gradle-wrapper.jar intentionally remains versionable.
